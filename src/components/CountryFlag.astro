---
const { slug, class: klass = '' } = Astro.props;

const flags = {
  almanya: `<rect width="60" height="12" y="0" fill="#000000"/><rect width="60" height="12" y="12" fill="#DD0000"/><rect width="60" height="12" y="24" fill="#FFCE00"/>`,
  italya: `<rect width="20" height="36" x="0" fill="#009246"/><rect width="20" height="36" x="20" fill="#FFFFFF"/><rect width="20" height="36" x="40" fill="#CE2B37"/>`,
  romanya: `<rect width="20" height="36" x="0" fill="#002B7F"/><rect width="20" height="36" x="20" fill="#FCD116"/><rect width="20" height="36" x="40" fill="#CE1126"/>`,
  cekya: `<rect width="60" height="18" y="0" fill="#FFFFFF"/><rect width="60" height="18" y="18" fill="#D7141A"/><polygon points="0,0 30,18 0,36" fill="#11457E"/>`,
  polonya: `<rect width="60" height="18" y="0" fill="#FFFFFF"/><rect width="60" height="18" y="18" fill="#DC143C"/>`,
  avusturya: `<rect width="60" height="12" y="0" fill="#ED2939"/><rect width="60" height="12" y="12" fill="#FFFFFF"/><rect width="60" height="12" y="24" fill="#ED2939"/>`,
};
const body = flags[slug] ?? '';
---
<span class={`flag-wrap inline-block ${klass}`} aria-hidden="true">
  <span class="flag-inner inline-flex items-stretch">
    <span class="w-[3px] rounded-full bg-ink/70"></span>
    <span class="block overflow-hidden rounded-[2px] shadow-sm ring-1 ring-black/10">
      <svg width="60" height="36" viewBox="0 0 60 36" set:html={body}></svg>
    </span>
  </span>
</span>
