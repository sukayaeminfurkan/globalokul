---
import { nav } from '../data/site.js';
---
<header class="sticky top-0 z-40 border-b border-hairline bg-surface/90 backdrop-blur">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href="#top" class="font-display text-xl font-extrabold tracking-tight">
      <span class="text-ink">GLOBAL</span><span class="text-ink">OKUL</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Ana menü">
      {nav.map((item) => (
        <a href={item.href} class="font-sans text-sm font-medium text-ink transition-colors hover:text-ink/60">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href="#randevu" class="btn hidden text-sm sm:inline-flex">Ücretsiz ön görüşme</a>
      <details class="relative md:hidden">
        <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-sm border border-hairline" aria-label="Menüyü aç">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </summary>
        <nav class="absolute right-0 mt-2 w-56 rounded-md border border-hairline bg-surface-raised p-2 shadow-lg" aria-label="Mobil menü">
          {nav.map((item) => (
            <a href={item.href} class="block rounded-sm px-3 py-2 font-sans text-sm text-ink hover:bg-surface">{item.label}</a>
          ))}
          <a href="#randevu" class="btn mt-2 w-full text-sm">Ücretsiz ön görüşme</a>
        </nav>
      </details>
    </div>
  </div>
</header>
