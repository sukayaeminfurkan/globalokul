---
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import Colophon from '../components/Colophon.astro';
import { site } from '../data/site.js';

const { title, description = site.description } = Astro.props;
const fullTitle = title
  ? (title.includes(site.name) ? title : `${title} · ${site.name}`)
  : `${site.name} — Yurt Dışı Eğitim Bülteni`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["EducationalOrganization", "LocalBusiness"],
  "name": "GlobalOkul",
  "description": "Yurt dışı eğitim danışmanlığı (Almanya başta olmak üzere Avrupa)",
  "url": "https://globalokul.com",
  "telephone": "+905435834369",
  "email": "info@globalokul.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Genç Cd. 50",
    "addressLocality": "Bingöl",
    "addressRegion": "Bingöl",
    "postalCode": "12010",
    "addressCountry": "TR"
  },
  "areaServed": "TR",
  "sameAs": [
    "https://www.instagram.com/globalokul/",
    "https://share.google/aCElzY5sCbpWwKCnB"
  ],
  "hasMap": "https://share.google/aCElzY5sCbpWwKCnB",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "10:00",
      "closes": "17:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Saturday",
      "opens": "09:00",
      "closes": "19:00"
    }
  ]
};
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <!-- Google Analytics (GA4) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-QH1LGN2HND"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-QH1LGN2HND');
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:bg-ink focus:px-4 focus:py-2 focus:text-surface">İçeriğe geç</a>
    <span id="top"></span>
    <Masthead />
    <main id="main">
      <slot />
    </main>
    <Colophon />
    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var els = document.querySelectorAll('.reveal');
        if (reduce || !('IntersectionObserver' in window)) { els.forEach(function(el){el.classList.add('vis');}); return; }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('vis'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -12% 0px' });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
